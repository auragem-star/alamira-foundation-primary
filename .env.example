# رابط قاعدة البيانات (Postgres) - من Vercel Postgres أو Neon أو أي مزود متوافق
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# مفتاح سري لتوقيع جلسات الدخول (JWT) - أي نص عشوائي طويل وسري
# ممكن تولده بالأمر: openssl rand -base64 32
AUTH_SECRET="غيّر_ده_لنص_سري_عشوائي_طويل"

# مفتاح Vercel Blob لتخزين الملفات (هيتضاف تلقائيًا لو فعّلت Vercel Blob من لوحة تحكم Vercel)
BLOB_READ_WRITE_TOKEN="سيتم توفيره تلقائيًا من Vercel"

# مفتاح سري لحماية رابط الحذف التلقائي (Cron) - أي نص عشوائي
CRON_SECRET="غيّر_ده_كمان_لنص_سري"

# بيانات حساب المدير الافتراضي (تُستخدم مرة واحدة بس عند تشغيل db:seed)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="غيّرها_فورًا_بعد_أول_دخول"
